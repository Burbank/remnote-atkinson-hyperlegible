/* Atkinson Hyperlegible Next Font Declarations */

@font-face {
  font-family: 'Atkinson Hyperlegible';
  src: url('data:font/woff2;charset=utf-8;base64,{{REGULAR_BASE64}}') format('woff2');
  font-weight: 400;
  font-style: normal;
  font-display: swap;
}

@font-face {
  font-family: 'Atkinson Hyperlegible';
  src: url('data:font/woff2;charset=utf-8;base64,{{ITALIC_BASE64}}') format('woff2');
  font-weight: 400;
  font-style: italic;
  font-display: swap;
}

@font-face {
  font-family: 'Atkinson Hyperlegible';
  src: url('data:font/woff2;charset=utf-8;base64,{{BOLD_BASE64}}') format('woff2');
  font-weight: 700;
  font-style: normal;
  font-display: swap;
}

@font-face {
  font-family: 'Atkinson Hyperlegible';
  src: url('data:font/woff2;charset=utf-8;base64,{{BOLD_ITALIC_BASE64}}') format('woff2');
  font-weight: 700;
  font-style: italic;
  font-display: swap;
}

/* Apply Atkinson Hyperlegible to RemNote - safer, more targeted approach */

/* Set base font on html and body */
html,
body {
  font-family: 'Atkinson Hyperlegible', -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', 'Oxygen', 'Ubuntu', 'Cantarell', 'Fira Sans', 'Droid Sans', 'Helvetica Neue', sans-serif !important;
}

/* Target RemNote's main content and editor areas */
.rem-text,
.rem-container,
.EditorContainer,
#document-sidebar,
[data-rem-container],
.rem-header,
.rem-bullet__container,
input:not([class*="icon"]),
textarea:not([class*="icon"]),
button:not([class*="icon"]),
select:not([class*="icon"]) {
  font-family: 'Atkinson Hyperlegible', -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', 'Oxygen', 'Ubuntu', 'Cantarell', 'Fira Sans', 'Droid Sans', 'Helvetica Neue', sans-serif !important;
}

/* Preserve monospace font for code elements */
code,
pre,
.code-block,
[data-rem-container-tags~="code"],
kbd,
samp,
tt,
var,
.CodeMirror {
  font-family: 'SF Mono', 'Monaco', 'Inconsolata', 'Fira Code', 'Fira Mono', 'Roboto Mono', 'Source Code Pro', 'Courier New', monospace !important;
}
